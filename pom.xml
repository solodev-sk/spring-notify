<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>sk.solodev</groupId>
    <artifactId>spring-notify-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-notify :: parent</name>
    <description>Channel-agnostic notification delivery framework for Spring Boot</description>

    <properties>
        <java.version>25</java.version>
        <twilio.version>10.6.3</twilio.version>
        <firebase-admin.version>9.9.0</firebase-admin.version>
        <google-http-client.version>2.1.0</google-http-client.version>
        <slack-api-client.version>1.45.3</slack-api-client.version>
        <pushy.version>0.15.4</pushy.version>
        <sendgrid.version>4.10.3</sendgrid.version>
        <vonage.version>8.11.0</vonage.version>
    </properties>

    <modules>
        <module>notify-bom</module>
        <module>notify-core</module>
        <module>notify-spring-boot-sms</module>
        <module>notify-spring-boot-push</module>
        <module>notify-spring-boot-email</module>
        <module>notify-spring-boot-chat</module>
        <module>notify-spring-boot-autoconfigure</module>
        <module>notify-test</module>
        <module>notify-spring-boot-starter-sms-twilio</module>
        <module>notify-spring-boot-starter-sms-vonage</module>
        <module>notify-spring-boot-starter-push-fcm</module>
        <module>notify-spring-boot-starter-push-apns</module>
        <module>notify-spring-boot-starter-email-smtp</module>
        <module>notify-spring-boot-starter-email-sendgrid</module>
        <module>notify-spring-boot-starter-chat-slack</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-push</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-email</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-chat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twilio.sdk</groupId>
                <artifactId>twilio</artifactId>
                <version>${twilio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.firebase</groupId>
                <artifactId>firebase-admin</artifactId>
                <version>${firebase-admin.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.google.cloud</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.netty</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.google.http-client</groupId>
                <artifactId>google-http-client-jackson2</artifactId>
                <version>${google-http-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slack.api</groupId>
                <artifactId>slack-api-client</artifactId>
                <version>${slack-api-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eatthepath</groupId>
                <artifactId>pushy</artifactId>
                <version>${pushy.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sendgrid</groupId>
                <artifactId>sendgrid-java</artifactId>
                <version>${sendgrid.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vonage</groupId>
                <artifactId>server-sdk</artifactId>
                <version>${vonage.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>

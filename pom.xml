<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>sk.solodev</groupId>
    <artifactId>spring-notify-parent</artifactId>
    <version>1.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-notify :: parent</name>
    <description>Channel-agnostic notification delivery framework for Spring Boot</description>
    <url>https://github.com/solodev-sk/spring-notify</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Dominik Kovács</name>
            <email>dominik.kovacs28@gmail.com</email>
            <organization>solodev</organization>
            <organizationUrl>https://github.com/solodev-sk</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/solodev-sk/spring-notify.git</connection>
        <developerConnection>scm:git:git@github.com:solodev-sk/spring-notify.git</developerConnection>
        <url>https://github.com/solodev-sk/spring-notify</url>
    </scm>

    <properties>
        <java.version>25</java.version>
        <!-- JDK 23+ no longer auto-runs classpath annotation processors; opt back in so the
             Spring Boot configuration-processor generates spring-configuration-metadata.json -->
        <maven.compiler.proc>full</maven.compiler.proc>
        <twilio.version>12.1.1</twilio.version>
        <firebase-admin.version>9.10.0</firebase-admin.version>
        <google-http-client.version>2.2.0</google-http-client.version>
        <slack-api-client.version>1.50.0</slack-api-client.version>
        <pushy.version>0.15.6</pushy.version>
        <sendgrid.version>4.10.3</sendgrid.version>
        <vonage.version>9.12.0</vonage.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
    </properties>

    <modules>
        <module>notify-bom</module>
        <module>notify-core</module>
        <module>notify-spring-boot-sms</module>
        <module>notify-spring-boot-push</module>
        <module>notify-spring-boot-email</module>
        <module>notify-spring-boot-chat</module>
        <module>notify-spring-boot-autoconfigure</module>
        <module>notify-test</module>
        <module>notify-spring-boot-outbox</module>
        <module>notify-spring-boot-starter-sms-twilio</module>
        <module>notify-spring-boot-starter-sms-vonage</module>
        <module>notify-spring-boot-starter-push-fcm</module>
        <module>notify-spring-boot-starter-push-apns</module>
        <module>notify-spring-boot-starter-email-smtp</module>
        <module>notify-spring-boot-starter-email-sendgrid</module>
        <module>notify-spring-boot-starter-chat-slack</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-push</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-email</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-chat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sk.solodev</groupId>
                <artifactId>notify-spring-boot-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.twilio.sdk</groupId>
                <artifactId>twilio</artifactId>
                <version>${twilio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.firebase</groupId>
                <artifactId>firebase-admin</artifactId>
                <version>${firebase-admin.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.google.cloud</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>io.netty</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.google.http-client</groupId>
                <artifactId>google-http-client-jackson2</artifactId>
                <version>${google-http-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.slack.api</groupId>
                <artifactId>slack-api-client</artifactId>
                <version>${slack-api-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.eatthepath</groupId>
                <artifactId>pushy</artifactId>
                <version>${pushy.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sendgrid</groupId>
                <artifactId>sendgrid-java</artifactId>
                <version>${sendgrid.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vonage</groupId>
                <artifactId>server-sdk</artifactId>
                <version>${vonage.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Activated by the release workflow (mvn -P release deploy). Attaches sources + javadoc,
         signs every artifact with GPG, and uploads the bundle to the Central Portal. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <!-- Sign with the pure-Java BouncyCastle signer, not the gpg binary:
                                 headless CI has no gpg-agent/pinentry, which the gpg signer requires.
                                 The bc signer reads the armored key and passphrase from the
                                 MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE env vars set on the deploy step. -->
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Upload, validate, and release to Maven Central automatically. -->
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
